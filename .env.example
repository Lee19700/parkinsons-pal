# Example environment variables for Parkinson's Pal
# For Railway deployment, see RAILWAY-DEPLOYMENT.md

# Backend server
PORT=3000
NODE_ENV=production
JWT_SECRET=replace-with-strong-secret-at-least-32-chars
ENCRYPTION_KEY=b29c590394fa2b36197724f6f84c7a4803592a4e79df945e3feb3c4aed7f5392

# For Railway: ALLOWED_ORIGINS should be your Railway domain or custom domain
# Example: https://parkinsons-pal-prod.up.railway.app
ALLOWED_ORIGINS=https://your-deployment-domain.up.railway.app

# Database (PostgreSQL)
# Railway automatically provides DATABASE_URL via service binding
# For local dev: postgres://user:password@localhost:5432/parkipal
# DO NOT override if running on Railway (Railway injects it automatically)
# DB_URL=postgres://user:password@host:5432/parkipal

# Local backup configuration
BACKUP_DIR=.\.backups

# NAS path (Windows UNC or mounted path)
NAS_PATH=\\192.168.0.48\backups\parkipal

# Encryption key file path (DO NOT COMMIT REAL KEY)
ENC_KEY_FILE=C:\\secure\\keys\\parkipal_backup.key
# Optional: local clone path to private GitHub backup repo (if used)
GIT_REPO_DIR=C:\\Users\\you\\repos\\parkipal-backups
