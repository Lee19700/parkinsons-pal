# Production deployment config for Parkinson's Pal

DOMAIN=parkipal.com
EMAIL=leetodd1970@gmail.com

# Allow your site origins to call the API
ALLOWED_ORIGINS=https://parkipal.com,https://www.parkipal.com

# Set a strong random secret before deploying
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Postgres credentials (you can change these)
PG_DB=parkipal
PG_USER=parkipal
PG_PASSWORD=change-me

# Derived DB_URL for backend services using compose networking
DB_URL=postgres://${PG_USER}:${PG_PASSWORD}@db:5432/${PG_DB}

# Backend port
PORT=3000

# Security & limits
# Maximum JSON request body size in MB
MAX_BODY_MB=10
# Rate limit window (ms) and max requests per IP per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
