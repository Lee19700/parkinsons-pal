# Backend environment example for production
# Copy to .env and set real values

# Connection string: postgres://user:password@host:port/dbname
DB_URL=postgres://postgres:postgres@localhost:5432/parkinsons_pal

# Port for Express server
PORT=3000

# Long, random secret for JWT signing
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of allowed frontend origins for CORS
# e.g., https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:8080
